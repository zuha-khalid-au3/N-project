{
  "name": "n-project",
  "version": "0.1.0",
  "private": true,
  "description": "Nemat Gems and Jewellery product catalogue",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c gold,cyan \"yarn dev:server\" \"yarn dev:client\"",
    "dev:client": "yarn workspace client dev",
    "dev:server": "yarn workspace server dev",
    "build": "yarn workspace client build",
    "start": "yarn workspace server start",
    "lint": "yarn workspace client lint && yarn workspace server lint",
    "create-admin": "yarn workspace server create-admin",
    "seed": "yarn workspace server seed",
    "test": "yarn workspace server test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
